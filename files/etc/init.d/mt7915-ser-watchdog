#!/bin/sh /etc/rc.common
# Auto-recovery for the WED-v1 MT7915 full-reset MCU-death failure.
# See /usr/sbin/mt7915-ser-watchdog and docs/e8450-ppe-validation.md
# (controlled-SER section) for the failure this works around.

START=99
USE_PROCD=1

PROG=/usr/sbin/mt7915-ser-watchdog

start_service() {
	[ -x "$PROG" ] || return 0
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
