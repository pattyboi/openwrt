
config adblock 'global'
	option adb_enabled '1'
	option adb_debug '0'
	# unbound backend: writes local-zone always_nxdomain entries that
	# unbound's UCI generator includes automatically (net/unbound README).
	option adb_dns 'unbound'
	option adb_trigger 'wan'
	# unbound README: boot-time restart races with interface-up triggers
	# on embedded devices; give it real headroom.
	option adb_triggerdelay '60'
	option adb_dnsshift '0'
	option adb_safesearch '0'
	option adb_mail '0'
	option adb_report '0'
	# Live RAM measurement (2026-09-25, router already running the DNS
	# cutover): oisd_small alone (57,391 domains) left 339MB/500MB
	# available -- well past the threshold this comment used to wait for.
	# Expanded to the 3 native feeds matching the Pi's non-amblock sources
	# (hagezi pro, oisd_big, StevenBlack fakenews -- see pi-tuning/dns
	# sources/00-base.adlist for the exact originals): 392,408 domains
	# total (~89% of the Pi's ~440k), 158MB/500MB still available after
	# reload, verified against no other trigger changes. AdmiraList and
	# the two hosts/amblock lists (Amazon tracker, Admiral) are not native
	# adblock feeds -- they would need a custom local-blocklist fetch
	# script (adb_locallist), not reproduced here yet.
	#
	# hagezi/stevenblack are adblock's "VAR" category feeds: the UCI
	# option value is the literal path suffix appended to the feed's base
	# URL, not a bare category name (adb_hag_feed/adb_stb_feed below).
	# hagezi's "wildcard/pro.txt" is *.domain-prefixed and adblock's
	# "rule: feed 1" parser silently produces zero domains against it
	# (logged as "preparation ... failed, rc: 0", not a download error) --
	# use the onlydomains variant, which is bare "domain.tld" per line.
	list adb_feed 'oisd_big'
	list adb_feed 'hagezi'
	list adb_feed 'stevenblack'
	option adb_hag_feed 'wildcard/pro-onlydomains.txt'
	option adb_stb_feed 'alternates/fakenews/hosts'
