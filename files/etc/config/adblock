
config adblock 'global'
	option adb_enabled '1'
	option adb_debug '0'
	# unbound backend: writes local-zone always_nxdomain entries that
	# unbound's UCI generator includes automatically (net/unbound README).
	option adb_dns 'unbound'
	option adb_trigger 'wan'
	# unbound README: boot-time restart races with interface-up triggers
	# on embedded devices; give it real headroom.
	option adb_triggerdelay '60'
	option adb_dnsshift '0'
	option adb_safesearch '0'
	option adb_mail '0'
	option adb_report '0'
	# Deliberately conservative for the first cutover: oisd_small is
	# "L" class (30k-80k domains), well inside adblock's own "XL (80k-200k)
	# should work for 256-512 MByte devices" guidance, on a board that also
	# runs PPE/WED/hostapd/luci concurrently — unlike a dedicated DNS box.
	# The Pi's current list is ~456k domains across 6 sources; that is NOT
	# reproduced here. Expand (hagezi/stevenblack/oisd_big) only after a
	# live RAM measurement confirms headroom post-cutover.
	list adb_feed 'oisd_small'
