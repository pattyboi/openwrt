config shaper 'wan'
	option enabled '1'
	option interface 'wan'
	option rate_kbps '8300'

# Production HQoS profile.
#
# toggle=2 is native PPPQ: the PPE stores queue = 3 + DSA port index, so WAN
# egress (DSA port 4) lands on q7 - the queue this shaper caps - and LAN
# egress lands on q3-q6, uncapped. toggle=1 instead takes the queue from the
# conntrack mark, which on this board applies to *both* FOE directions (the
# driver's asymmetric ct_mark>>16 path is gated on GDM2, unreachable when WAN
# is a DSA port), putting bulk download and every download's ACK stream inside
# the 8,300 kbit/s upload bucket. Measured cost of that: 5.7 vs 76.6 Mbit/s
# downstream on a 75 Mbit/s line.
#
# scheduler_rate_kbps must stay 0. All 16 QDMA queues report scheduler 0, so a
# scheduler max-rate is an aggregate ceiling over every QDMA egress path -
# every switch port, both directions, offloaded and software-forwarded alike.
# The previous 9500 value was a router-wide throughput cap. Shape per queue.
config hqos 'production'
	option enabled '1'
	option toggle '2'
	option scheduler '0'
	option scheduler_mode 'wrr'
	option scheduler_rate_kbps '0'
	option bulk_queue '7'
	option bulk_weight '4'
	option bulk_rate_kbps '8300'
	option priority_queue '8'
	option priority_weight '12'
	# qos_prio_map: learned EF/AF41/CS4/CS5 flows egressing bulk_queue's port
	# are moved to priority_queue instead of qos-10's hardcoded q4 (which is
	# DSA port 1's own PPPQ queue). Other egress ports keep their own queue.
	option prio_map '1'
