From: OpenWrt E8450 investigation <noreply@example.invalid>
Subject: [PATCH] mac80211: parameterize IEEE80211_MIN_ACTION_SIZE

Newer mt76 (2026-08-04 pin) calls IEEE80211_MIN_ACTION_SIZE(addba_req.capab)
to compute the minimum frame size up to and including a specific action
subtype's payload, but this tree's macro is still the older
argument-less form (base offset of the action union only), so the call
expands to offsetof(...)(addba_req.capab) - calling an integer as a
function - and fails to build.

Make the macro variadic with __VA_OPT__: called with no arguments it
expands to exactly the previous offsetof(struct ieee80211_mgmt,
u.action.u), byte-for-byte identical to today's behavior; called with a
field path it appends '.<field>' to reach that action subtype's start.
Update every existing argument-less call site tree-wide (this header's
own seven, plus net/mac80211/s1g.c, mesh_plink.c, mesh_hwmp.c, ibss.c,
and rx.c - 28 in total) to the new explicit-empty-args form.

Signed-off-by: OpenWrt E8450 investigation <noreply@example.invalid>
---
--- a/include/linux/ieee80211.h
+++ b/include/linux/ieee80211.h
@@ -1636,7 +1636,8 @@
 #define BSS_MEMBERSHIP_SELECTOR_MIN	BSS_MEMBERSHIP_SELECTOR_EHT_PHY
 
 /* mgmt header + 1 byte category code */
-#define IEEE80211_MIN_ACTION_SIZE offsetof(struct ieee80211_mgmt, u.action.u)
+#define IEEE80211_MIN_ACTION_SIZE(...) \
+	offsetof(struct ieee80211_mgmt, u.action.u __VA_OPT__(.) __VA_ARGS__)
 
 
 /* Management MIC information element (IEEE 802.11w) */
@@ -4691,7 +4692,7 @@
  */
 static inline bool ieee80211_is_robust_mgmt_frame(struct sk_buff *skb)
 {
-	if (skb->len < IEEE80211_MIN_ACTION_SIZE)
+	if (skb->len < IEEE80211_MIN_ACTION_SIZE())
 		return false;
 	return _ieee80211_is_robust_mgmt_frame((void *)skb->data);
 }
@@ -4707,7 +4708,7 @@
 {
 	struct ieee80211_mgmt *mgmt = (void *)hdr;
 
-	if (len < IEEE80211_MIN_ACTION_SIZE)
+	if (len < IEEE80211_MIN_ACTION_SIZE())
 		return false;
 	if (!ieee80211_is_action(hdr->frame_control))
 		return false;
@@ -4728,10 +4729,10 @@
 	u8 action;
 
 	if (!ieee80211_is_public_action((void *)skb->data, skb->len) ||
-	    skb->len < IEEE80211_MIN_ACTION_SIZE + 1)
+	    skb->len < IEEE80211_MIN_ACTION_SIZE() + 1)
 		return false;
 
-	action = *(u8 *)(skb->data + IEEE80211_MIN_ACTION_SIZE);
+	action = *(u8 *)(skb->data + IEEE80211_MIN_ACTION_SIZE());
 
 	return action != WLAN_PUB_ACTION_20_40_BSS_COEX &&
 		action != WLAN_PUB_ACTION_DSE_REG_LOC_ANN &&
@@ -4770,7 +4771,7 @@
  */
 static inline bool ieee80211_is_group_privacy_action(struct sk_buff *skb)
 {
-	if (skb->len < IEEE80211_MIN_ACTION_SIZE)
+	if (skb->len < IEEE80211_MIN_ACTION_SIZE())
 		return false;
 	return _ieee80211_is_group_privacy_action((void *)skb->data);
 }
@@ -5114,7 +5115,7 @@
 	if (!ieee80211_is_action(mgmt->frame_control))
 		return false;
 
-	if (skb->len < IEEE80211_MIN_ACTION_SIZE +
+	if (skb->len < IEEE80211_MIN_ACTION_SIZE() +
 		       sizeof(mgmt->u.action.u.tpc_report))
 		return false;
 
@@ -5155,7 +5156,7 @@
 {
 	struct ieee80211_mgmt *mgmt = (void *)skb->data;
 
-	if (skb->len < IEEE80211_MIN_ACTION_SIZE)
+	if (skb->len < IEEE80211_MIN_ACTION_SIZE())
 		return false;
 
 	if (!ieee80211_is_action(mgmt->frame_control))
