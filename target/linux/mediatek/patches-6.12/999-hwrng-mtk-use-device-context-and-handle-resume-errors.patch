From: pat <pi3iman@gmail.com>
Subject: [PATCH] hwrng: mtk: use device context and handle resume errors

Store the device pointer directly in the MediaTek RNG context instead of
round-tripping it through the unsigned long hwrng private field, following
the upstream MediaTek device-context conversion.

Also replace pm_runtime_get_sync() with pm_runtime_resume_and_get() and
propagate errors.  The old code accessed RNG registers even when runtime
resume, including clock enable, failed and left the PM usage counter
incremented on that error path.

Keep the explicit pm_runtime_mark_last_busy() required by the Linux 6.12
runtime-PM implementation.

Link: https://git.kernel.org/linus/c2c460c30af5240d1894692306aa3a2377964f9e
Signed-off-by: pat <pi3iman@gmail.com>
---
 drivers/char/hw_random/mtk-rng.c | 15 +++++++++------
 1 file changed, 9 insertions(+), 6 deletions(-)

--- a/drivers/char/hw_random/mtk-rng.c
+++ b/drivers/char/hw_random/mtk-rng.c
@@ -36,6 +36,7 @@ struct mtk_rng {
 	void __iomem *base;
 	struct clk *clk;
 	struct hwrng rng;
+	struct device *dev;
 };
 
 static int mtk_rng_init(struct hwrng *rng)
@@ -84,8 +85,11 @@ static int mtk_rng_read(struct hwrng *rng, void *buf, size_t max, bool wait)
 {
 	struct mtk_rng *priv = to_mtk_rng(rng);
 	int retval = 0;
+	int err;
 
-	pm_runtime_get_sync((struct device *)priv->rng.priv);
+	err = pm_runtime_resume_and_get(priv->dev);
+	if (err)
+		return err;
 
 	while (max >= sizeof(u32)) {
 		if (!mtk_rng_wait_ready(rng, wait))
@@ -97,8 +101,8 @@ static int mtk_rng_read(struct hwrng *rng, void *buf, size_t max, bool wait)
 		max -= sizeof(u32);
 	}
 
-	pm_runtime_mark_last_busy((struct device *)priv->rng.priv);
-	pm_runtime_put_sync_autosuspend((struct device *)priv->rng.priv);
+	pm_runtime_mark_last_busy(priv->dev);
+	pm_runtime_put_sync_autosuspend(priv->dev);
 
 	return retval || !wait ? retval : -EIO;
 }
@@ -112,13 +116,13 @@ static int mtk_rng_probe(struct platform_device *pdev)
 	if (!priv)
 		return -ENOMEM;
 
+	priv->dev = &pdev->dev;
 	priv->rng.name = pdev->name;
 #ifndef CONFIG_PM
 	priv->rng.init = mtk_rng_init;
 	priv->rng.cleanup = mtk_rng_cleanup;
 #endif
 	priv->rng.read = mtk_rng_read;
-	priv->rng.priv = (unsigned long)&pdev->dev;
 	priv->rng.quality = 900;
 
 	priv->clk = devm_clk_get(&pdev->dev, "rng");
