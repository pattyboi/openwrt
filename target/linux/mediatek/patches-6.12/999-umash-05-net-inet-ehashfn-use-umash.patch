From: pat <pi3iman@gmail.com>
Subject: [PATCH] net: use UMASH for the inet established/UDP portaddr hashes

Three more jhash call sites, found by grepping net/ + include/net/ for
jhash|hsiphash and checking each for hot-path + packet-input exposure
(see conversation notes; conntrack/flow_dissector siphash sites and
the rhashtable-default-hash bridge fdb table were assessed and left
alone -- either already keyed+hot enough to need real perf numbers
first, or too broad a blast radius for this experiment).

- include/net/inet_sock.h: __inet_ehashfn() -- IPv4 TCP/UDP
  established-socket hash (inet_ehashfn(), udp_ehashfn()). Called from
  __inet_lookup_established() on every inbound packet for a socket
  this box owns: softirq, hot.
- include/net/inet6_hashtables.h: __inet6_ehashfn() -- same thing for
  IPv6.
- include/net/ip.h: ipv4_portaddr_hash() -- UDP secondary (hash2/hash4)
  bind-table hash. Hot on the UDP lookup path, control-path on bind.

All three inputs are <=12 bytes, so they only ever take UMASH's scalar
short/medium path -- no PMULL, no NEON, no kernel_neon_begin/end, safe
in any context including hardirq. ipv4_portaddr_hash's real win here
is the proven collision bound, not speed: jhash_1word on 4 bytes is
already about as fast as a hash gets.

Each of the three keeps its own function-local `static struct
umash_params`, matching the existing per-site secret pattern already
in this code (inet_ehash_secret, udp_ehash_secret are likewise
separate per call site, not shared) -- and avoids the cross-TU-race
that a single shared extern instance would have if initialised via
DO_ONCE() from inside a static inline header function that gets
compiled into more than one translation unit. The existing per-site
"initval" (inet_ehash_secret/udp_ehash_secret + net_hash_mix()) is
still threaded through unchanged as the UMASH seed, preserving the
existing per-table domain separation on top of UMASH's own keying.

Falls back to the original jhash on !CONFIG_UMASH builds, same as the
nft_set_hash.c and lib/umash.c patches earlier in this series.

Signed-off-by: pat <pi3iman@gmail.com>
---
--- a/include/net/inet_sock.h
+++ b/include/net/inet_sock.h
@@ -17,6 +17,10 @@
 #include <linux/types.h>
 #include <linux/jhash.h>
 #include <linux/netdevice.h>
+#ifdef CONFIG_UMASH
+#include <linux/umash.h>
+#include <linux/once.h>
+#endif
 
 #include <net/flow.h>
 #include <net/sock.h>
@@ -383,10 +387,23 @@ static inline unsigned int __inet_ehashfn(const __be32 laddr,
 					  const __be16 fport,
 					  u32 initval)
 {
+#ifdef CONFIG_UMASH
+	static struct umash_params __read_mostly params;
+	struct {
+		__be32 laddr, faddr;
+		__u32 ports;
+	} __packed key = {
+		laddr, faddr, ((__u32) lport) << 16 | (__force __u32) fport,
+	};
+
+	DO_ONCE(umash_params_init_random, &params);
+	return (u32)umash_full(&params, initval, &key, sizeof(key));
+#else
 	return jhash_3words((__force __u32) laddr,
 			    (__force __u32) faddr,
 			    ((__u32) lport) << 16 | (__force __u32)fport,
 			    initval);
+#endif
 }
 
 struct request_sock *inet_reqsk_alloc(const struct request_sock_ops *ops,
--- a/include/net/inet6_hashtables.h
+++ b/include/net/inet6_hashtables.h
@@ -16,6 +16,10 @@
 #include <linux/ipv6.h>
 #include <linux/types.h>
 #include <linux/jhash.h>
+#ifdef CONFIG_UMASH
+#include <linux/umash.h>
+#include <linux/once.h>
+#endif
 
 #include <net/inet_sock.h>
 
@@ -31,7 +35,18 @@ static inline unsigned int __inet6_ehashfn(const u32 lhash,
 				    const u32 initval)
 {
 	const u32 ports = (((u32)lport) << 16) | (__force u32)fport;
+
+#ifdef CONFIG_UMASH
+	static struct umash_params __read_mostly params;
+	struct {
+		u32 lhash, fhash, ports;
+	} __packed key = { lhash, fhash, ports };
+
+	DO_ONCE(umash_params_init_random, &params);
+	return (u32)umash_full(&params, initval, &key, sizeof(key));
+#else
 	return jhash_3words(lhash, fhash, ports, initval);
+#endif
 }
 
 /*
--- a/include/net/ip.h
+++ b/include/net/ip.h
@@ -25,6 +25,10 @@
 #include <linux/jhash.h>
 #include <linux/sockptr.h>
 #include <linux/static_key.h>
+#ifdef CONFIG_UMASH
+#include <linux/umash.h>
+#include <linux/once.h>
+#endif
 
 #include <net/inet_sock.h>
 #include <net/route.h>
@@ -703,7 +707,14 @@ static inline u32 ipv4_portaddr_hash(const struct net *net,
 				     __be32 saddr,
 				     unsigned int port)
 {
+#ifdef CONFIG_UMASH
+	static struct umash_params __read_mostly params;
+
+	DO_ONCE(umash_params_init_random, &params);
+	return (u32)umash_full(&params, net_hash_mix(net), &saddr, sizeof(saddr)) ^ port;
+#else
 	return jhash_1word((__force u32)saddr, net_hash_mix(net)) ^ port;
+#endif
 }
 
 bool ip_call_ra_chain(struct sk_buff *skb);
