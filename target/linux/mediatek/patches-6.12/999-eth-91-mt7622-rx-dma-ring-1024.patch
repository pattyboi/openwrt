From: pat <pi3iman@gmail.com>
Subject: [PATCH] net: ethernet: mtk_eth_soc: double MT7622 RX DMA ring to 1024

The MT7622 (NETSYSv1) Ethernet RX ring is 512 descriptors while the TX
ring is 2K.  Under moderate traffic the RX ring fills faster than the
NAPI budget drains it, causing RX drops before packets reach the PPE
flow table.  Doubling from 512 to 1024 (MTK_DMA_SIZE(x) == SZ_##x, so
1K == 1024) costs one extra page of contiguous DMA memory.

Wide context anchors the hunk on MT7622_CLKS_BITMAP so it can only match
this SoC (other NETSYSv1 SoCs share an identical 512-desc rx block).
WED v1 has no RX capability, so this ring is not in any WED data path.

Signed-off-by: pat <pi3iman@gmail.com>
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -5774,41 +5774,41 @@
 	.hw_features = MTK_HW_FEATURES,
 	.required_clks = MT7622_CLKS_BITMAP,
 	.required_pctl = false,
 	.version = 1,
 	.offload_version = 2,
 	.ppe_num = 1,
 	.hash_offset = 2,
 	.has_accounting = true,
 	.foe_entry_size = MTK_FOE_ENTRY_V1_SIZE,
 	.tx = {
 		DESC_SIZE(struct mtk_tx_dma),
 		.dma_max_len = MTK_TX_DMA_BUF_LEN,
 		.dma_len_offset = 16,
 		.dma_size = MTK_DMA_SIZE(2K),
 		.fq_dma_size = MTK_DMA_SIZE(2K),
 	},
 	.rx = {
 		DESC_SIZE(struct mtk_rx_dma),
 		.irq_done_mask = MTK_RX_DONE_INT,
 		.dma_l4_valid = RX_DMA_L4_VALID,
-		.dma_size = MTK_DMA_SIZE(512),
+		.dma_size = MTK_DMA_SIZE(1K),
 		.dma_max_len = MTK_TX_DMA_BUF_LEN,
 		.dma_len_offset = 16,
 	},
 };
 
 static const struct mtk_soc_data mt7623_data = {
 	.reg_map = &mtk_reg_map,
 	.caps = MT7623_CAPS | MTK_HWLRO,
 	.hw_features = MTK_HW_FEATURES,
 	.required_clks = MT7623_CLKS_BITMAP,
 	.required_pctl = true,
 	.version = 1,
 	.offload_version = 1,
 	.ppe_num = 1,
 	.hash_offset = 2,
 	.foe_entry_size = MTK_FOE_ENTRY_V1_SIZE,
 	.disable_pll_modes = true,
 	.tx = {
 		DESC_SIZE(struct mtk_tx_dma),
 		.dma_max_len = MTK_TX_DMA_BUF_LEN,
