From: pat <pi3iman@gmail.com>
Subject: [PATCH] mediatek/mt7622: trace and gate mtk_eth stop/open stages

The E8450 bind-time hard lock was first blamed on MT7622 WED attach MMIO,
but later hardware runs disproved that:

- with wed_attach_max_access=0 (all traced WED/WDMA/WPDMA/mirror/HIFSYS
  MMIO skipped and attach forced to fail), the box still locked
- a plain detached `ip link set eth0 down; sleep 3; ip link set eth0 up`
  locked identically with no WED, PCI, or mt7915 involvement
- a deadman script on a debug kernel proved `reboot -f` also failed to
  recover the hang, which points at a bus-level lock rather than a
  recoverable oops or watchdog-reset path

So the next bisect target is the mtk_eth stop/open cycle itself, especially
the close/reopen path driven by mtk_eth_set_dma_device() during WED attach
and detach on a dma-coherent MT7622 FE node.

Add a coarse harness in mtk_eth_soc.c:

- `eth_debug_breadcrumb=1` enables emergency stage logs for
  mtk_eth_set_dma_device(), mtk_stop(), and mtk_open()
- `eth_stop_max_stage=N` makes mtk_stop() execute only stages 1..N and then
  return success; `-1` disables the gate
- `eth_open_max_stage=N` does the same for mtk_open()

This is intentionally a sacrificial bisect harness. Returning success from a
shortened stop/open sequence is not a production-safe behavior, but it lets
SSH-visible runs tell whether the lock first appears in stop, open, or the
DMA-device swap wrapper at the cost of a single power-cycle when the
crossing stage is found.

Signed-off-by: pat <pi3iman@gmail.com>
---
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -41,6 +41,38 @@
 module_param_named(msg_level, mtk_msg_level, int, 0);
 MODULE_PARM_DESC(msg_level, "Message level (-1=defaults,0=none,...,16=all)");
 
+static bool eth_debug_breadcrumb;
+module_param(eth_debug_breadcrumb, bool, 0644);
+MODULE_PARM_DESC(eth_debug_breadcrumb,
+		 "trace mtk_eth stop/open and dma-device swap stages with pr_emerg for hardware hang bisect");
+
+static int eth_stop_max_stage = -1;
+module_param(eth_stop_max_stage, int, 0644);
+MODULE_PARM_DESC(eth_stop_max_stage,
+		 "with eth_debug_breadcrumb set: execute mtk_stop stages 1..N and then return success; -1 disables");
+
+static int eth_open_max_stage = -1;
+module_param(eth_open_max_stage, int, 0644);
+MODULE_PARM_DESC(eth_open_max_stage,
+		 "with eth_debug_breadcrumb set: execute mtk_open stages 1..N and then return success; -1 disables");
+
+static bool mtk_eth_debug_stage(struct net_device *dev, const char *path,
+				int stage, int max_stage, const char *label)
+{
+	bool allow = true;
+
+	if (!eth_debug_breadcrumb)
+		return true;
+
+	if (max_stage >= 0 && stage > max_stage)
+		allow = false;
+
+	pr_emerg("ETH-BI dev=%s path=%s stage=%d max=%d %s%s\n",
+		 dev->name, path, stage, max_stage, label,
+		 allow ? "" : " SKIP");
+	return allow;
+}
+
 #define MTK_ETHTOOL_STAT(x) { #x, \
 			      offsetof(struct mtk_hw_stats, x) / sizeof(u64) }
 
@@ -3785,6 +3817,9 @@
 	int i, err, ppe_num, mtu;
 
 	ppe_num = eth->soc->ppe_num;
+	if (!mtk_eth_debug_stage(dev, "open", 1, eth_open_max_stage,
+				 "phy-connect"))
+		return 0;
 
 	if (mac->pextp)
 		phy_power_on(mac->pextp);
@@ -3802,15 +3837,25 @@
 		u32 gdm_config;
 		int i;
 
+		if (!mtk_eth_debug_stage(dev, "open", 2, eth_open_max_stage,
+					 "start-dma"))
+			return 0;
+
 		err = mtk_start_dma(eth);
 		if (err) {
 			phylink_disconnect_phy(mac->phylink);
 			return err;
 		}
 
+		if (!mtk_eth_debug_stage(dev, "open", 3, eth_open_max_stage,
+					 "ppe-start"))
+			return 0;
 		for (i = 0; i < ARRAY_SIZE(eth->ppe); i++)
 			mtk_ppe_start(eth->ppe[i]);
 
+		if (!mtk_eth_debug_stage(dev, "open", 4, eth_open_max_stage,
+					 "gdm-config"))
+			return 0;
 		for (i = 0; i < MTK_MAX_DEVS; i++) {
 			if (!eth->netdev[i])
 				continue;
@@ -3832,10 +3877,16 @@
 			mtk_gdm_config(eth, target_mac->id, gdm_config);
 		}
 
+		if (!mtk_eth_debug_stage(dev, "open", 5, eth_open_max_stage,
+					 "ppe-mtu"))
+			return 0;
 		mtu = mtk_max_gmac_mtu(eth);
 		for (i = 0; i < ARRAY_SIZE(eth->ppe); i++)
 			mtk_ppe_update_mtu(eth->ppe[i], mtu);
 
+		if (!mtk_eth_debug_stage(dev, "open", 6, eth_open_max_stage,
+					 "napi+irq-enable"))
+			return 0;
 		napi_enable(&eth->tx_napi);
 		napi_enable(&eth->rx_napi);
 		mtk_tx_irq_enable(eth, MTK_TX_DONE_INT);
@@ -3845,12 +3896,18 @@
 		refcount_inc(&eth->dma_refcnt);
 	}
 
+	if (!mtk_eth_debug_stage(dev, "open", 7, eth_open_max_stage,
+				 "phylink+queues"))
+		return 0;
 	phylink_start(mac->phylink);
 	netif_tx_start_all_queues(dev);
 
 	if (mtk_is_netsys_v2_or_greater(eth))
 		return 0;
 
+	if (!mtk_eth_debug_stage(dev, "open", 8, eth_open_max_stage,
+				 "tail-config"))
+		return 0;
 	if (mtk_uses_dsa(dev) && !eth->prog) {
 		for (i = 0; i < ARRAY_SIZE(eth->dsa_meta); i++) {
 			struct metadata_dst *md_dst = eth->dsa_meta[i];
@@ -3910,6 +3967,9 @@
 	struct mtk_eth *eth = mac->hw;
 	int i;
 
+	if (!mtk_eth_debug_stage(dev, "stop", 1, eth_stop_max_stage,
+				 "phylink+tx-disable"))
+		return 0;
 	phylink_stop(mac->phylink);
 
 	netif_tx_disable(dev);
@@ -3920,26 +3980,51 @@
 	if (!refcount_dec_and_test(&eth->dma_refcnt))
 		return 0;
 
+	if (!mtk_eth_debug_stage(dev, "stop", 2, eth_stop_max_stage,
+				 "gdm-drop-all"))
+		return 0;
 	for (i = 0; i < MTK_MAX_DEVS; i++)
 		mtk_gdm_config(eth, i, MTK_GDMA_DROP_ALL);
 
+	if (!mtk_eth_debug_stage(dev, "stop", 3, eth_stop_max_stage,
+				 "irq+napi-disable"))
+		return 0;
 	mtk_tx_irq_disable(eth, MTK_TX_DONE_INT);
 	mtk_rx_irq_disable(eth, eth->soc->rx.irq_done_mask);
 	napi_disable(&eth->tx_napi);
 	napi_disable(&eth->rx_napi);
 
+	if (!mtk_eth_debug_stage(dev, "stop", 4, eth_stop_max_stage,
+				 "cancel-work"))
+		return 0;
 	cancel_work_sync(&eth->rx_dim.work);
 	cancel_work_sync(&eth->tx_dim.work);
 
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA) &&
+	    !mtk_eth_debug_stage(dev, "stop", 5, eth_stop_max_stage,
+				 "qdma-stop"))
+		return 0;
 	if (MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA))
 		mtk_stop_dma(eth, eth->soc->reg_map->qdma.glo_cfg);
+	if (!mtk_eth_debug_stage(dev, "stop", 6, eth_stop_max_stage,
+				 "pdma-stop"))
+		return 0;
 	mtk_stop_dma(eth, eth->soc->reg_map->pdma.glo_cfg);
 
+	if (!mtk_eth_debug_stage(dev, "stop", 7, eth_stop_max_stage,
+				 "dma-free"))
+		return 0;
 	mtk_dma_free(eth);
 
+	if (!mtk_eth_debug_stage(dev, "stop", 8, eth_stop_max_stage,
+				 "ppe-stop"))
+		return 0;
 	for (i = 0; i < ARRAY_SIZE(eth->ppe); i++)
 		mtk_ppe_stop(eth->ppe[i]);
 
+	if (!mtk_eth_debug_stage(dev, "stop", 9, eth_stop_max_stage,
+				 "phy-power-off"))
+		return 0;
 	if (mac->pextp)
 		phy_power_off(mac->pextp);
 
@@ -5371,7 +5456,12 @@
 {
 	struct net_device *dev, *tmp;
 	LIST_HEAD(dev_list);
-	int i;
+	int i, up = 0;
+
+	if (eth_debug_breadcrumb)
+		pr_emerg("ETH-DMA-SWAP enter old=%s new=%s\n",
+			 eth->dma_dev ? dev_name(eth->dma_dev) : "(null)",
+			 dma_dev ? dev_name(dma_dev) : "(null)");
 
 	rtnl_lock();
 
@@ -5381,19 +5471,34 @@
 		if (!dev || !(dev->flags & IFF_UP))
 			continue;
 
+		up++;
 		list_add_tail(&dev->close_list, &dev_list);
 	}
 
+	if (eth_debug_breadcrumb)
+		pr_emerg("ETH-DMA-SWAP close-many up=%d\n", up);
 	dev_close_many(&dev_list, false);
 
+	if (eth_debug_breadcrumb)
+		pr_emerg("ETH-DMA-SWAP closed up=%d\n", up);
 	eth->dma_dev = dma_dev;
 
+	if (eth_debug_breadcrumb)
+		pr_emerg("ETH-DMA-SWAP dma-dev-set=%s\n",
+			 eth->dma_dev ? dev_name(eth->dma_dev) : "(null)");
 	list_for_each_entry_safe(dev, tmp, &dev_list, close_list) {
+		if (eth_debug_breadcrumb)
+			pr_emerg("ETH-DMA-SWAP reopen dev=%s\n", dev->name);
 		list_del_init(&dev->close_list);
 		dev_open(dev, NULL);
+		if (eth_debug_breadcrumb)
+			pr_emerg("ETH-DMA-SWAP reopened dev=%s\n", dev->name);
 	}
 
 	rtnl_unlock();
+
+	if (eth_debug_breadcrumb)
+		pr_emerg("ETH-DMA-SWAP done up=%d\n", up);
 }
 
 static int mtk_sgmii_init(struct mtk_eth *eth)
